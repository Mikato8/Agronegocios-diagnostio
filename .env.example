# ---------------------------------------------------------------------------
# AgroNegocios MX · configuración
# ---------------------------------------------------------------------------
APP_NAME="AgroNegocios MX"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://tu-dominio.mx
APP_TIMEZONE=America/Mexico_City
APP_LOCALE=es_MX
APP_KEY=

# Neon PostgreSQL. En Hostinger, PDO necesita el parámetro options con el
# endpoint para que libpq antiguo encuentre la rama correcta.
DATABASE_URL="postgresql://USUARIO:CLAVE@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require&options=endpoint%3Dep-xxxx"
DATABASE_URL_UNPOOLED="postgresql://USUARIO:CLAVE@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require&options=endpoint%3Dep-xxxx"
DB_DRIVER=pdo

SESSION_NAME=agronegocios_session
SESSION_LIFETIME=7200
SESSION_SECURE=true

UPLOAD_MAX_BYTES=8388608
UPLOAD_MAX_FILES=4
UPLOAD_MAX_DOCUMENT_BYTES=12582912

MAIL_ENABLED=false
MAIL_FROM=no-reply@tu-dominio.mx
MAIL_FROM_NAME="AgroNegocios MX"
AUTO_VERIFY_USERS=false
